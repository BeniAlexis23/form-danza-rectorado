# Pegar en Environment del servicio Docker Compose de Dokploy.
# MySQL se incluye en el Compose; no hace falta indicar MYSQL_HOST.
MYSQL_DATABASE=undc_danzas
MYSQL_USER=undc_danzas
MYSQL_PASSWORD=
# Una contraseña distinta para el administrador interno de MySQL.
MYSQL_ROOT_PASSWORD=
ADMIN_EMAIL=
# Exactamente 10 caracteres.
ADMIN_KEY=
TRUST_PROXY=1
TEST_MODE=false
REGISTRATION_CLOSES_AT=2026-11-14T00:00:00-05:00
