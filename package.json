{
  "name": "rectorado-danzas-undc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "tsx watch backend/src/index.ts",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p backend/tsconfig.json",
    "start": "node dist/backend/src/start.js",
    "db:init:prod": "node dist/backend/src/init.js",
    "db:init": "tsx backend/src/init.ts",
    "test": "tsx --test backend/src/rules.test.ts backend/src/auth.test.ts",
    "test:integration": "tsx --test backend/src/integration.test.ts",
    "format": "prettier --write frontend/src backend/src shared vite.config.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.15.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
