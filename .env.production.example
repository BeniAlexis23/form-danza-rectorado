NODE_ENV=production
HOST=0.0.0.0
PORT=3001
# Una conexión directa desde Traefik de Dokploy. Ajustar si hay más proxies.
TRUST_PROXY=1
# Host interno del servicio MySQL de Dokploy, nunca localhost.
MYSQL_HOST=REEMPLAZAR_HOST_INTERNO_MYSQL
MYSQL_PORT=3306
MYSQL_USER=undc_danzas
MYSQL_PASSWORD=REEMPLAZAR_PASSWORD_MYSQL
MYSQL_DATABASE=undc_danzas
ADMIN_EMAIL=REEMPLAZAR_CORREO
# Debe tener exactamente 10 caracteres. No guardar credenciales reales en GitHub.
ADMIN_KEY=
RUN_DB_INIT=true
# Dokploy crea la base; la aplicación solamente crea sus tablas.
DB_CREATE_DATABASE=false
TEST_MODE=false
REGISTRATION_CLOSES_AT=2026-11-14T00:00:00-05:00
